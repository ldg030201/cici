# 크롬 웹스토어 배포용 자격 증명.
#
# 이 파일을 `.env` 로 복사해서 값을 채운다. `.env` 는 .gitignore 에 있다 —
# 커밋되면 리프레시 토큰이 공개 저장소로 나간다.
#
#   cp .env.example .env
#
# 값을 얻는 방법은 docs/release.md 를 보라.
# GitHub Actions 는 이 파일을 쓰지 않는다. 저장소 시크릿을 쓴다.

# 개발자 대시보드 주소에 들어 있는 게시자 ID
CWS_PUBLISHER_ID=

# 확장의 웹스토어 ID(32자). 스토어 주소 끝부분
CWS_ITEM_ID=

# Google Cloud OAuth 클라이언트 (웹 애플리케이션 유형)
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=

# OAuth Playground 에서 chromewebstore 범위로 발급받은 리프레시 토큰
CWS_REFRESH_TOKEN=
