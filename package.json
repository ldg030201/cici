{
  "name": "cici",
  "version": "0.1.0",
  "description": "Claude Code 브라우저 선택창의 UUID(bridgeDeviceId)가 어느 크롬 프로필의 것인지 알려 준다. 읽기 전용, 의존성 0.",
  "type": "module",
  "bin": {
    "cici": "./bin/cici.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node bin/cici.js",
    "build:ext": "node scripts/build-extension.mjs",
    "check:ext": "node scripts/build-extension.mjs --check",
    "icons": "node scripts/make-icons.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "claude",
    "claude-code",
    "claude-in-chrome",
    "bridgedeviceid",
    "chrome",
    "chrome-profile",
    "chrome-extension",
    "chromium",
    "leveldb",
    "snappy",
    "devtools",
    "cli"
  ],
  "author": "ldg030201",
